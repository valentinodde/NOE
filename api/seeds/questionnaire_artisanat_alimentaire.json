      "order": 7,
      "type": "single_choice",
      "text": "Vos équipements de froid ou votre refroidisseur d'eau sont-ils refroidis par de l'eau rejetée à l'égout ?",
      "condition": null,
      "options": [
        {
          "id": "eau_perdue",
          "text": "Oui, au moins un équipement fonctionne à eau perdue",
          "maturity_score": 0,
          "concern_score": 1,
          "topics": [
            "froid"
          ]
        },
