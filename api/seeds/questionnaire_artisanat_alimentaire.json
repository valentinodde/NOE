          "concern_score": 2,
          "topics": [
            "equipements"
          ]
        },
        {
          "id": "complet",
          "text": "Mousseurs partout et douchette de prélavage à gâchette",
          "maturity_score": 2,
          "concern_score": 2,
          "topics": []
        },
        {
          "id": "complet_controle",
