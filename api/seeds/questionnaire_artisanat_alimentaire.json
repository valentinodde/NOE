          "maturity_score": 0,
          "concern_score": 0,
          "topics": [
            "froid"
          ]
        },
        {
          "id": "sans_eau_perdue",
          "text": "Non, vérifié : tout est refroidi par air ou en boucle fermée",
          "maturity_score": 3,
          "concern_score": 3,
          "topics": []
        }
      ]
    },
