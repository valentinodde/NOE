  "questions": [
    {
      "id": "art_q01",
      "theme": "connaissance",
      "order": 1,
      "type": "single_choice",
      "text": "Comment suivez-vous aujourd'hui la consommation d'eau de votre entreprise ?",
      "condition": null,
      "options": [
        {
          "id": "facture",
          "text": "Je m'en remets à la facture du service d'eau",
          "maturity_score": 0,
          "concern_score": 0,
          "topics": [
            "comptage"
          ]
        },
        {
          "id": "releve_occasionnel",
          "text": "Je relève le compteur de temps en temps",
          "maturity_score": 1,
          "concern_score": 1,
          "topics": [
            "comptage"
          ]
        },
        {
          "id": "releve_hebdo",
          "text": "Je relève le compteur chaque semaine et je compare",
          "maturity_score": 2,
          "concern_score": 2,
          "topics": []
        },
        {
          "id": "releve_et_fuites",
          "text": "Relevé chaque semaine et contrôle des fuites le soir et le matin",
          "maturity_score": 3,
          "concern_score": 3,
          "topics": []
        }
      ]
    },
    {
      "id": "art_q02",
      "theme": "connaissance",
      "order": 2,
      "type": "single_choice",
      "text": "Votre compteur d'eau dessert-il aussi votre logement ou un autre local ?",
      "condition": null,
      "options": [
        {
          "id": "compteur_partage",
          "text": "Oui, un seul compteur pour l'entreprise et le logement",
          "maturity_score": 1,
          "concern_score": 1,
          "topics": [
            "comptage"
          ]
        },
        {
          "id": "compteur_propre",
          "text": "Non, il ne dessert que l'entreprise",
          "maturity_score": 2,
          "concern_score": 2,
          "topics": []
        },
        {
          "id": "sous_compteur_labo",
          "text": "Oui, mais le laboratoire a son propre sous-compteur",
          "maturity_score": 3,
          "concern_score": 3,
          "topics": []
        }
      ]
    },
    {
      "id": "art_q03",
      "theme": "connaissance",
      "order": 3,
      "type": "single_choice",
      "text": "Avez-vous fait réaliser un diagnostic eau de votre laboratoire, par exemple par votre chambre de métiers ?",
      "condition": null,
      "options": [
        {
          "id": "jamais",
          "text": "Non, jamais",
          "maturity_score": 0,
          "concern_score": 0,
          "topics": [
            "audit"
          ]
        },
        {
          "id": "envisage",
          "text": "Non, mais nous l'envisageons",
          "maturity_score": 0,
          "concern_score": 2,
          "topics": [
            "audit"
          ]
        },
        {
          "id": "ancien",
          "text": "Oui, il y a plus de cinq ans",
          "maturity_score": 1,
          "concern_score": 1,
          "topics": [
            "audit"
          ]
        },
        {
          "id": "recent",
          "text": "Oui, depuis moins de cinq ans, et nous avons suivi ses conseils",
          "maturity_score": 3,
          "concern_score": 3,
          "topics": []
        }
      ]
    },
    {
      "id": "art_q04",
      "theme": "laboratoire",
      "order": 4,
      "type": "single_choice",
      "text": "Avant de laver sols, plans de travail et ustensiles, que retirez-vous à sec ?",
      "condition": null,
      "options": [
        {
          "id": "jet_direct",
          "text": "Rien : nous lavons directement au jet ou à grande eau",
          "maturity_score": 0,
          "concern_score": 0,
          "topics": [
            "nettoyage"
          ]
        },
        {
          "id": "parfois",
          "text": "Nous raclons ou aspirons quand nous y pensons",
          "maturity_score": 1,
          "concern_score": 1,
          "topics": [
            "nettoyage"
          ]
        },
        {
          "id": "systematique",
          "text": "Graisses raclées, farine aspirée et siphons vidés à chaque fois",
          "maturity_score": 2,
          "concern_score": 2,
          "topics": []
        },
        {
          "id": "systematique_consigne",
          "text": "Systématique, avec une consigne affichée et suivie par tous",
          "maturity_score": 3,
          "concern_score": 3,
          "topics": []
        }
      ]
    },
    {
      "id": "art_q05",
      "theme": "laboratoire",
      "order": 5,
      "type": "single_choice",
      "text": "Comment l'équipe lave-t-elle bacs, moules et ustensiles à la plonge ?",
      "condition": null,
      "options": [
        {
          "id": "eau_courante",
          "text": "Sous l'eau courante, robinet ouvert pendant le lavage",
          "maturity_score": 0,
          "concern_score": 0,
          "topics": [
            "gestes"
          ]
        },
        {
          "id": "variable",
          "text": "Chacun fait à sa façon, rien n'a été expliqué",
          "maturity_score": 1,
          "concern_score": 1,
          "topics": [
            "gestes"
          ]
        },
        {
          "id": "bac",
          "text": "Dans un bac rempli, les gestes sont montrés aux nouveaux",
          "maturity_score": 2,
          "concern_score": 2,
          "topics": []
        },
        {
          "id": "bac_forme",
          "text": "Au bac ou au lave-batterie, gestes montrés à tous et rappelés",
          "maturity_score": 3,
          "concern_score": 3,
          "topics": []
        }
      ]
    },
    {
      "id": "art_q06",
      "theme": "laboratoire",
      "order": 6,
      "type": "single_choice",
      "text": "Vos robinets et votre plonge sont-ils équipés pour limiter le débit d'eau ?",
      "condition": null,
      "options": [
        {
          "id": "aucun",
